# Supabase (leave empty to use the built-in localStorage database)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin account used for Supabase Auth. The login form accepts the email
# itself, or a plain login name which is mapped to this email.
VITE_ADMIN_EMAIL=admin@titansfc.local

# Credentials for the local fallback (used only when Supabase is not configured)
VITE_ADMIN_LOGIN=admin
VITE_ADMIN_PASSWORD=titans2026
